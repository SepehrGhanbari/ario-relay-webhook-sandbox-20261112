+def consume_intent_authority(authority: MergeIntentAuthority, intent_bytes: bytes,
+                             evidence_root: str) -> dict:
+    """Durably and atomically consume one authority for exactly one evidence root.
+
+    F10 fix for the VERIFIED double-use: ``verify_intent_authority`` is a
+    read-only re-check, so a single authority could be accepted by two roots
+    before any LOCAL_EVIDENCE_RECORDED event. This function performs the check
+    *and* a one-time reservation in a single ``BEGIN IMMEDIATE`` transaction,
+    committed BEFORE any journal write. The reservation is bound to the exact
+    intent bytes (marker) and the exact evidence root.
+
+    Semantics:
+      * Second/duplicate consumption of the same (repo, pr) is refused with
+        ``PermissionError("AUTHORITY_ALREADY_CONSUMED")`` even if a fresh
+        authority object is minted for the same claim.
+      * A crash AFTER this commit but BEFORE the journal write leaves the intent
+        CONSUMED with no journal row: HOLD, never automatic takeover/retry.
+
+    Preserved limits (NOT fixed here, disclosed): a copied/restored/forked DB
+    resets consumption; a same-owner interpreter can still call
+    ``EvidenceJournal._append_merge_intent_raw``; no cryptographic token and no
+    independent custody is provided. This is supported-contract enforcement on
+    ONE shared SQLite file only.
+    """
+    if not isinstance(authority, MergeIntentAuthority):
+        raise PermissionError("INVALID_MERGE_INTENT_AUTHORITY")
+    intent = EvidenceJournal._validated_merge_intent(intent_bytes)
+    if digest(intent_bytes) != authority.marker:
+        raise PermissionError("AUTHORITY_INTENT_MISMATCH")
+    if (intent["repo"], intent["pr"]) != (authority.repo, authority.pr):
+        raise PermissionError("AUTHORITY_INTENT_MISMATCH")
+    if not isinstance(evidence_root, str) or not evidence_root:
+        raise ValueError("INVALID_EVIDENCE_ROOT")
+    coord = SharedCoordinator(Path(authority.db_path))
+    try:
+        with closing(coord._connect()) as db:
+            db.execute("BEGIN IMMEDIATE")
+            row, _ = _read_claim_row(db, authority.repo, authority.pr)
+            if row is None or tuple(row) != (authority.marker, authority.root_label):
+                db.rollback()
+                raise PermissionError("AUTHORITY_NOT_DURABLE")
+            if db.execute("SELECT 1 FROM consumptions WHERE repo=? AND pr=?", (
+                    authority.repo, authority.pr)).fetchone() is not None:
+                # Audit the refused reuse, then refuse: one intent, one root.
+                db.execute("INSERT INTO events(repo,pr,marker,phase,root_label) VALUES(?,?,?,?,?)", (
+                    authority.repo, authority.pr, authority.marker,
+                    "REFUSED_AUTHORITY_REUSE", authority.root_label))
+                db.commit()
+                raise PermissionError("AUTHORITY_ALREADY_CONSUMED")
+            db.execute("INSERT INTO consumptions(repo,pr,marker,root_label,evidence_root,consumed_utc) VALUES(?,?,?,?,?,?)", (
+                authority.repo, authority.pr, authority.marker, authority.root_label,
+                evidence_root, utc_now()))
+            db.execute("INSERT INTO events(repo,pr,marker,phase,root_label) VALUES(?,?,?,?,?)", (
+                authority.repo, authority.pr, authority.marker,
+                "AUTHORITY_CONSUMED", authority.root_label))
+            db.commit()
+            return _hold("AUTHORITY_CONSUMED_LOCAL_WRITE_PENDING", consumed=True,
+                         evidence_root=evidence_root)
+    except sqlite3.Error as exc:
+        raise ValueError("COORDINATOR_UNAVAILABLE_OR_CORRUPT") from exc
+
+
