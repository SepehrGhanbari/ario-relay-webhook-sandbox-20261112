+    @staticmethod
+    def _current_local_snapshot(root: Path, marker: str, *, expected_intent: bytes | None = None) -> tuple[str, str]:
+        """Best-effort exact local readback; cannot lock external files atomically.
+
+        Check the raw journal bytes before and after a complete journal.read()
+        and a second time just before returning, rejecting a change between
+        samples. This is NOT proof that files remain unmodified after return.
+        """
+        journal = EvidenceJournal(root)
+        journal._safe_root()
+        if not journal.index.is_file() or journal.index.is_symlink():
+            raise ValueError("LOCAL_OBSERVATION_INDEX_NOT_PRESENT")
+        first = journal.index.read_bytes()
+        records = journal.read()  # checks hash-chain, objects, claims, and marker
+        second = journal.index.read_bytes()
+        if first != second:
+            raise ValueError("LOCAL_OBSERVATION_INDEX_CHANGED_DURING_READ")
+        matches = [r for r in records if r["event"] == "merge-intent" and r["source"] == "local"
+                   and r["payload_sha256"] == marker]
+        if len(matches) != 1:
+            raise ValueError("GLOBAL_OBSERVATION_JOURNAL_NOT_VERIFIED")
+        item = matches[0]
+        raw = (root/item["payload_path"]).read_bytes()
+        if digest(raw) != marker or (expected_intent is not None and raw != expected_intent):
+            raise ValueError("GLOBAL_OBSERVATION_JOURNAL_NOT_VERIFIED")
+        if journal.index.read_bytes() != first:
+            raise ValueError("LOCAL_OBSERVATION_INDEX_CHANGED_DURING_READ")
+        return digest(first), item["record_hash"]
